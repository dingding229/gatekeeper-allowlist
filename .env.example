DOMAIN=allowlist.example.com
# Optional explicit public origin. DOMAIN is used as https://DOMAIN by default.
# PUBLIC_BASE_URL=https://allowlist.example.com
ACME_EMAIL=admin@example.com

# Admin dashboard credentials. Use at least 12 characters in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-this-password
ADMIN_PATH=/manage-example

# Optional unless nftables synchronization is enabled. Minimum 24 characters.
FIREWALL_SYNC_TOKEN=replace-with-another-long-random-token

# Set to 1 only when behind a trusted reverse proxy (for example Nginx).
TRUST_PROXY=0
# Set to 1 when the public site is served over HTTPS.
COOKIE_SECURE=0

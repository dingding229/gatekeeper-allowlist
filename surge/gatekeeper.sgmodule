#!name=Gatekeeper 自动加白
#!desc=按自定义周期和网络切换事件，将 Surge 当前出口 IP 所属网段自动加入 Gatekeeper 白名单，并提供手动刷新面板。
#!category=Gatekeeper
#!author=dingding229
#!arguments=domain:"",url:"",key:"",interval:"3"
#!arguments-desc=domain: Gatekeeper 域名（不含 https://）；url: 完整站点地址（例如 https://allowlist.example.com）；key: awl_ 开头的 API Key；interval: 上报间隔分钟（建议 3、5、10、15、30 或 60）

[Rule]
# 必须直连，确保服务端识别到本机真实出口 IP，而不是代理节点 IP。
DOMAIN,{{{domain}}},DIRECT,extended-matching
DOMAIN,64.ipcheck.ing,DIRECT,extended-matching

[Script]
gatekeeper-cron = type=cron,cronexp="*/{{{interval}}} * * * *",script-path=https://raw.githubusercontent.com/dingding229/gatekeeper-allowlist/main/surge/gatekeeper.js,timeout=30,argument="url={{{url}}}&key={{{key}}}"
gatekeeper-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/dingding229/gatekeeper-allowlist/main/surge/gatekeeper.js,timeout=30,argument="url={{{url}}}&key={{{key}}}"
gatekeeper-panel = type=generic,script-path=https://raw.githubusercontent.com/dingding229/gatekeeper-allowlist/main/surge/gatekeeper.js,timeout=30,argument="url={{{url}}}&key={{{key}}}"

[Panel]
gatekeeper_manual_panel = title="Gatekeeper 自动加白",content="点击右上角刷新按钮手动加白",style=info,script-name=gatekeeper-panel

#!name=Gatekeeper 自动加白
#!version=1.1.0
#!desc=每 10 分钟、网络切换或面板触发时检查；模块 v1.1.0。
#!category=Gatekeeper
#!author=dingding229
#!arguments=domain:"",url:"",key:"",cooldown:"30"
#!arguments-desc=domain: Gatekeeper 域名（不含 https://）；url: 完整站点地址（例如 https://allowlist.example.com）；key: awl_ 开头的 API Key；cooldown: 防重复上报秒数

[Rule]
# 必须直连，确保服务端识别到本机真实出口 IP，而不是代理节点 IP。
DOMAIN,{{{domain}}},DIRECT,extended-matching
DOMAIN,64.ipcheck.ing,DIRECT,extended-matching

[Script]
gatekeeper-cron = type=cron,cronexp="*/10 * * * *",script-path=https://raw.githubusercontent.com/dingding229/gatekeeper-allowlist/main/surge/gatekeeper.js?v=1.1.0,script-update-interval=300,timeout=30,argument="url={{{url}}}&key={{{key}}}&cooldown={{{cooldown}}}&moduleVersion=1.1.0"
gatekeeper-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/dingding229/gatekeeper-allowlist/main/surge/gatekeeper.js?v=1.1.0,script-update-interval=300,timeout=30,argument="url={{{url}}}&key={{{key}}}&cooldown={{{cooldown}}}&moduleVersion=1.1.0"
gatekeeper-panel = type=generic,script-path=https://raw.githubusercontent.com/dingding229/gatekeeper-allowlist/main/surge/gatekeeper.js?v=1.1.0,script-update-interval=300,timeout=30,argument="url={{{url}}}&key={{{key}}}&cooldown={{{cooldown}}}&moduleVersion=1.1.0"

[Panel]
gatekeeper_manual_panel = title="Gatekeeper 自动加白 v1.1.0",content="点击右上角刷新上报当前 IP",style=info,script-name=gatekeeper-panel

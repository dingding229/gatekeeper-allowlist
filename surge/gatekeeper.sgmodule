#!name=Gatekeeper 自动加白
#!version=2.0.1
#!desc=出口 IP 变化时才提交，10 分钟定时检查；模块 v2.0.1。
#!category=Gatekeeper
#!author=dingding229
#!arguments=domain:"",url:"",key:"",cooldown:"30"
#!arguments-desc=domain: Gatekeeper 域名（不含 https://）；url: 完整站点地址（例如 https://allowlist.example.com）；key: awl_ 开头的 API Key；cooldown: 防重复上报秒数

[Rule]
# 必须直连，确保服务端识别到本机真实出口 IP，而不是代理节点 IP。
DOMAIN,{{{domain}}},DIRECT,extended-matching
DOMAIN,64.ipcheck.ing,DIRECT,extended-matching

[Script]
gatekeeper-cron = type=cron,cronexp="*/10 * * * *",script-path=https://raw.githubusercontent.com/dingding229/gatekeeper-allowlist/main/surge/gatekeeper.js?v=2.0.1,script-update-interval=300,timeout=30,argument="url={{{url}}}&key={{{key}}}&cooldown={{{cooldown}}}&moduleVersion=2.0.1&moduleUrl=https%3A%2F%2Fraw.githubusercontent.com%2Fdingding229%2Fgatekeeper-allowlist%2Fmain%2Fsurge%2Fgatekeeper.sgmodule"
gatekeeper-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/dingding229/gatekeeper-allowlist/main/surge/gatekeeper.js?v=2.0.1,script-update-interval=300,timeout=30,argument="url={{{url}}}&key={{{key}}}&cooldown={{{cooldown}}}&moduleVersion=2.0.1&moduleUrl=https%3A%2F%2Fraw.githubusercontent.com%2Fdingding229%2Fgatekeeper-allowlist%2Fmain%2Fsurge%2Fgatekeeper.sgmodule"
gatekeeper-panel = type=generic,script-path=https://raw.githubusercontent.com/dingding229/gatekeeper-allowlist/main/surge/gatekeeper.js?v=2.0.1,script-update-interval=300,timeout=30,argument="url={{{url}}}&key={{{key}}}&cooldown={{{cooldown}}}&moduleVersion=2.0.1&moduleUrl=https%3A%2F%2Fraw.githubusercontent.com%2Fdingding229%2Fgatekeeper-allowlist%2Fmain%2Fsurge%2Fgatekeeper.sgmodule"

[Panel]
gatekeeper_manual_panel = title="Gatekeeper 自动加白 v2.0.1",content="点击右上角手动检查并上报当前 IP",style=info,script-name=gatekeeper-panel

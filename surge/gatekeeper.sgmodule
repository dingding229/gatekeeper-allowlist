#!name=Gatekeeper 自动加白
#!desc=定期检查 Surge 当前出口 IP，自动任务仅在 IP 变化时上报，面板按钮可手动强制上报。
#!category=Gatekeeper
#!author=dingding229
#!arguments=domain:"",url:"",key:"",interval:"3",cooldown:"30",device:"Surge"
#!arguments-desc=domain: Gatekeeper 域名（不含 https://）；url: 完整站点地址（例如 https://allowlist.example.com）；key: awl_ 开头的 API Key；interval: 上报间隔分钟；cooldown: 防重复上报秒数；device: 后台显示的设备名称

[Rule]
# 必须直连，确保服务端识别到本机真实出口 IP，而不是代理节点 IP。
DOMAIN,{{{domain}}},DIRECT,extended-matching
DOMAIN,64.ipcheck.ing,DIRECT,extended-matching

[Script]
gatekeeper-cron = type=cron,cronexp="*/{{{interval}}} * * * *",script-path=https://raw.githubusercontent.com/dingding229/gatekeeper-allowlist/main/surge/gatekeeper.js?v=20260802-5,script-update-interval=300,timeout=30,argument="url={{{url}}}&key={{{key}}}&cooldown={{{cooldown}}}&device={{{device}}}"
gatekeeper-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/dingding229/gatekeeper-allowlist/main/surge/gatekeeper.js?v=20260802-5,script-update-interval=300,timeout=30,argument="url={{{url}}}&key={{{key}}}&cooldown={{{cooldown}}}&device={{{device}}}"
gatekeeper-panel = type=generic,script-path=https://raw.githubusercontent.com/dingding229/gatekeeper-allowlist/main/surge/gatekeeper.js?v=20260802-5,script-update-interval=300,timeout=30,argument="url={{{url}}}&key={{{key}}}&cooldown={{{cooldown}}}&device={{{device}}}"

[Panel]
gatekeeper_manual_panel = title="Gatekeeper 自动加白",content="点击右上角刷新可强制上报当前 IP",style=info,script-name=gatekeeper-panel

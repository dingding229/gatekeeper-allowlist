#!/usr/sbin/nft -f

table inet gatekeeper {
  set allowed_v4 {
    type ipv4_addr
    flags interval
    elements = { __INITIAL_IPV4__ }
  }

  set allowed_v6 {
    type ipv6_addr
    flags interval
    elements = { __INITIAL_IPV6__ }
  }

  set protected_tcp_ports {
    type inet_service
    flags interval
    elements = { __INITIAL_TCP_PORTS__ }
  }

  set protected_udp_ports {
    type inet_service
    flags interval
    elements = { __INITIAL_UDP_PORTS__ }
  }

  chain input {
    type filter hook input priority -5; policy accept;
    ct state established,related accept
    iifname "lo" accept
    tcp dport @protected_tcp_ports ip saddr @allowed_v4 accept
    tcp dport @protected_tcp_ports ip6 saddr @allowed_v6 accept
    tcp dport @protected_tcp_ports reject
    udp dport @protected_udp_ports ip saddr @allowed_v4 accept
    udp dport @protected_udp_ports ip6 saddr @allowed_v6 accept
    udp dport @protected_udp_ports reject
  }
}

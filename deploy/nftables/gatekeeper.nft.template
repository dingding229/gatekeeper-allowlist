#!/usr/sbin/nft -f

table inet gatekeeper {
  set allowed_v4 {
    type ipv4_addr
    flags interval
    __INITIAL_IPV4_ELEMENTS__
  }

  set allowed_v6 {
    type ipv6_addr
    flags interval
    __INITIAL_IPV6_ELEMENTS__
  }

  set protected_tcp_ports {
    type inet_service
    flags interval
    __INITIAL_TCP_PORT_ELEMENTS__
  }

  set protected_udp_ports {
    type inet_service
    flags interval
    __INITIAL_UDP_PORT_ELEMENTS__
  }

  chain input {
    type filter hook input priority -5; policy accept;
    ct state established,related accept
    iifname "lo" accept
    tcp dport @protected_tcp_ports ip saddr @allowed_v4 accept
    tcp dport @protected_tcp_ports ip6 saddr @allowed_v6 accept
    tcp dport @protected_tcp_ports reject
    udp dport @protected_udp_ports ip saddr @allowed_v4 accept
    udp dport @protected_udp_ports ip6 saddr @allowed_v6 accept
    udp dport @protected_udp_ports reject
  }

  # Docker-published ports normally traverse the forward hook after DNAT.
  # Match the original public port so mappings such as 8443:443 are protected.
  chain forward {
    type filter hook forward priority -5; policy accept;
    ct state established,related accept
    ct status dnat meta l4proto tcp ct original proto-dst @protected_tcp_ports ip saddr @allowed_v4 accept
    ct status dnat meta l4proto tcp ct original proto-dst @protected_tcp_ports ip6 saddr @allowed_v6 accept
    ct status dnat meta l4proto tcp ct original proto-dst @protected_tcp_ports reject
    ct status dnat meta l4proto udp ct original proto-dst @protected_udp_ports ip saddr @allowed_v4 accept
    ct status dnat meta l4proto udp ct original proto-dst @protected_udp_ports ip6 saddr @allowed_v6 accept
    ct status dnat meta l4proto udp ct original proto-dst @protected_udp_ports reject
  }
}
